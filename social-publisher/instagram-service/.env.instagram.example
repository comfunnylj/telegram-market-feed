# Copy to .env.instagram ON ORACLE ONLY. Never commit the filled-in file.
IG_ENABLED=false
IG_USER_ID=REPLACE_WITH_META_INSTAGRAM_USER_ID
IG_USERNAME=REPLACE_WITH_EXACT_INSTAGRAM_USERNAME
IG_ACCESS_TOKEN=REPLACE_WITH_INSTAGRAM_LOGIN_LONG_LIVED_TOKEN
IG_GRAPH_VERSION=v26.0
IG_POLL_SECONDS=180
IG_MEDIA_HOSTS=raw.githubusercontent.com
IG_OUTBOX_URL=https://raw.githubusercontent.com/comfunnylj/telegram-market-feed/main/social-publisher/instagram/outbox.json
IG_DB_PATH=/data/instagram.sqlite3
IG_STATUS_PATH=/data/status.json
